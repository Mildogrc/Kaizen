# Kaizen configuration. Copy to .env for local use; in the cloud set these as
# environment variables / secrets on your platform.

# --- required ------------------------------------------------------------------
# PostgreSQL 14+ connection string (a NEW database; never the original app's).
DATABASE_URL=postgresql://kaizen:kaizen@localhost:5432/kaizen

# Externally visible origin. OAuth redirects use <this>/auth/callback.
KAIZEN_PUBLIC_URL=http://127.0.0.1:8787

# 32-byte key (base64 or hex) that encrypts stored API keys and ChatGPT tokens.
# Required whenever KAIZEN_PUBLIC_URL is not localhost. `openssl rand -base64 32`
# (Local installs generate one in KAIZEN_DATA_DIR if unset.)
KAIZEN_SECRET_KEY=

# --- server --------------------------------------------------------------------
# Listen address. Defaults to 127.0.0.1:8787; platforms that inject PORT get 0.0.0.0:$PORT.
# KAIZEN_BIND=127.0.0.1:8787
# PORT=8080
# Built web app directory (Docker image: /srv/kaizen/web).
# KAIZEN_WEB_DIR=web/dist
# Local state (generated secret key, AI CLI sandbox). Default ~/.config/kaizen
# KAIZEN_DATA_DIR=
# json for log shippers; RUST_LOG adjusts levels (e.g. info,kaizen=debug).
# KAIZEN_LOG_FORMAT=json
# Secure cookies default to on for https public URLs.
# KAIZEN_SECURE_COOKIES=true

# --- accounts & sign-in --------------------------------------------------------
# The owner may use this machine's AI CLI logins and the instance API keys below.
# Without it, a localhost install treats its user as the owner.
KAIZEN_OWNER_EMAIL=
# Hosted installs only accept the owner and these emails (comma separated)...
# KAIZEN_ALLOWED_EMAILS=friend@example.com
# ...unless sign-up is opened to anyone with a Google/ChatGPT account.
# KAIZEN_OPEN_SIGNUP=false

# Sign-in is OAuth only: ChatGPT (recommended — it also connects the plan for AI)
# and/or Google. At least one must be available.

# Google sign-in: create an OAuth client (Web application) in Google Cloud Console
# with redirect URI <KAIZEN_PUBLIC_URL>/auth/callback.
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# "Sign in with ChatGPT" (also connects the ChatGPT plan for AI). On localhost
# Kaizen registers itself automatically with a loopback redirect; hosted
# deployments need a registered client id.
# AUTH_OPENAI_CLIENT_ID=

# --- AI (instance-wide fallbacks, owner only) ----------------------------------
# Users normally connect their own subscription or key under Settings → AI.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# Paths to the official CLIs if they are not on PATH.
# KAIZEN_CLAUDE_BIN=
# KAIZEN_CODEX_BIN=
# KAIZEN_AGY_BIN=
# Long-lived token from `claude setup-token` for a headless server you own.
# KAIZEN_CLAUDE_OAUTH_TOKEN=

# --- integrations --------------------------------------------------------------
# AnkiConnect. auto = call it directly on localhost, relay through the browser tab
# when hosted. direct | relay | auto
# ANKI_CONNECT_URL=http://127.0.0.1:8765
# ANKI_TRANSPORT=auto
# Optional: YouTube Data API key for reliable playlist imports.
# YOUTUBE_API_KEY=
